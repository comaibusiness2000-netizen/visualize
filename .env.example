# Kairum premium speech endpoint used by the iOS app.
# Example after deploying Netlify:
# EXPO_PUBLIC_TTS_ENDPOINT=https://your-site.netlify.app/.netlify/functions/tts
EXPO_PUBLIC_TTS_ENDPOINT=

# Optional. If KAIRUM_TTS_TOKEN is configured on Netlify, put the same value here.
# This is not a secret once shipped in the app, but it prevents casual public use.
EXPO_PUBLIC_TTS_CLIENT_TOKEN=
